# Bind the credential and endpoint in the same environment.
AGENT_WORKSPACE_PROVIDER=openai-compatible
AGENT_WORKSPACE_BASE_URL=https://api.openai.com/v1
AGENT_WORKSPACE_API_KEY=replace-me
AGENT_WORKSPACE_MODEL=replace-me

# Optional local data override.
# AGENT_WORKSPACE_DATA_DIR=C:\Users\you\AppData\Local\AgentWorkspace
